# ── .env.dev — Local development environment ──────────────────────────────────
# Copy this to .env to run the full stack locally.
# Requires: Docker Desktop (or Docker Engine), Python 3.12+
# Does NOT require: a GPU, a GGUF model file, Kafka, or Dynatrace/Grafana.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev-only-secret-key-change-in-production-32c

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opsintel
POSTGRES_USER=opsintel
POSTGRES_PASSWORD=devpassword

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=operational_knowledge

# ── Kafka — disabled in dev (set to localhost, consumers won't crash) ──────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM Provider — mock mode, no real LLM needed ──────────────────────────────
# Set LLM_PROVIDER=mock to skip all LLM calls and return canned responses.
# Change to llamacpp/vllm when you have a running backend.
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-required
LLM_MODEL_NAME=mock-model

# ── Embeddings — use a small fast model for dev ────────────────────────────────
# "mock" skips the actual model download entirely (returns zero vectors).
# Use "BAAI/bge-small-en-v1.5" (~130MB) for real embeddings in dev.
# Use "BAAI/bge-large-en-v1.5" (~1.3GB) for production quality.
EMBEDDING_MODEL=mock
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Reranker — disable in dev to avoid downloading a second model ──────────────
RERANKER_ENABLED=false

# ── Telemetry Provider — use mock, no Dynatrace/Grafana needed ─────────────────
TELEMETRY_PROVIDER=mock

# ── OIDC — disabled in dev (uses a built-in dev principal) ────────────────────
OIDC_ENABLED=false

# ── OTel self-instrumentation — disabled in dev ────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-orchestrator

# ── Correlation window ─────────────────────────────────────────────────────────
CORRELATION_WINDOW_BEFORE_MINUTES=10
CORRELATION_WINDOW_AFTER_MINUTES=5
