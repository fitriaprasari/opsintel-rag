# Environment configuration — copy to .env and fill in values
# NEVER commit .env to version control

# ── AI Orchestrator ────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-at-least-32-chars-long

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opsintel
POSTGRES_USER=opsintel
POSTGRES_PASSWORD=changeme

# ── Qdrant ─────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=operational_knowledge
# Optional: QDRANT_API_KEY=

# ── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TELEMETRY=telemetry-raw
KAFKA_TOPIC_INCIDENTS=incident-events
KAFKA_TOPIC_AUDIT=audit-events
KAFKA_TOPIC_FEEDBACK=rag-feedback

# ── LLM Provider ───────────────────────────────────────────────
# LLM_PROVIDER: llamacpp | vllm
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://llamacpp:8080/v1
LLM_API_KEY=not-required-for-local
LLM_MODEL_NAME=mistral-7b-instruct
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# ── Embeddings ─────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Reranker ───────────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# ── Retrieval ──────────────────────────────────────────────────
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_FUSION_TOP_K=10
RETRIEVAL_MIN_SCORE=0.3

# ── Telemetry Provider ─────────────────────────────────────────
# TELEMETRY_PROVIDER: mock | dynatrace | grafana | opentelemetry
TELEMETRY_PROVIDER=mock

# Dynatrace (if TELEMETRY_PROVIDER=dynatrace)
# DYNATRACE_URL=https://your-env.live.dynatrace.com
# DYNATRACE_TOKEN=

# Grafana (if TELEMETRY_PROVIDER=grafana)
# GRAFANA_URL=http://grafana:3000
# GRAFANA_API_KEY=
# LOKI_URL=http://loki:3100
# TEMPO_URL=http://tempo:3200
# MIMIR_URL=http://mimir:9009

# ── OIDC / Auth ────────────────────────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER=https://keycloak:8080/realms/opsintel
OIDC_AUDIENCE=opsintel-api
OIDC_JWKS_URI=https://keycloak:8080/realms/opsintel/protocol/openid-connect/certs

# ── OTel Self-Instrumentation ──────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Correlation Engine ─────────────────────────────────────────
CORRELATION_WINDOW_BEFORE_MINUTES=10
CORRELATION_WINDOW_AFTER_MINUTES=5

# ── Gateway (Go) ───────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_UPSTREAM_URL=http://ai-orchestrator:8000
